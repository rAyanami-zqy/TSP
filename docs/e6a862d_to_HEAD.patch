+        for (int v = 1; v < n_; ++v) {
+            if (in_tree[static_cast<std::size_t>(v)]) continue;
+            const double weight = dist_[next][v];
+            if (weight < nearest[static_cast<std::size_t>(v)]) {
+                nearest[static_cast<std::size_t>(v)] = weight;
+                parent[static_cast<std::size_t>(v)] = next;
+            }
+        }
